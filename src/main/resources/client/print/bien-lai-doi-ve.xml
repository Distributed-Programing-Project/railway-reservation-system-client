<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
	name="BienLaiDoiVe" pageWidth="595" pageHeight="420" orientation="Landscape"
	columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
	whenNoDataType="AllSectionsNoDetail" isIgnorePagination="true">

	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
	<property name="net.sf.jasperreports.print.keep.full.text" value="true"/>

	<parameter name="p_MaGiaoDich" class="java.lang.String"/>
	<parameter name="p_NgayLap" class="java.lang.String"/>
	<parameter name="p_NhanVien" class="java.lang.String"/>

	<parameter name="p_SoLuongVe" class="java.lang.Integer"/>
	<parameter name="p_TongVeCu" class="java.lang.Double"/>
	<parameter name="p_TongVeMoi" class="java.lang.Double"/>
	<parameter name="p_PhiDoiMoiVe" class="java.lang.Double"/>
	<parameter name="p_TongPhiDoi" class="java.lang.Double"/>
	<parameter name="p_ChenhLechGia" class="java.lang.Double"/>
	<parameter name="p_ThanhToan" class="java.lang.Double"/>

	<field name="oldRoute" class="java.lang.String"/>
	<field name="oldPrice" class="java.lang.Double"/>
	<field name="newRoute" class="java.lang.String"/>
	<field name="newPrice" class="java.lang.Double"/>

	<title>
		<band height="90" splitType="Stretch">
			<staticText>
				<reportElement x="127" y="50" width="300" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="18" isBold="true"/>
				</textElement>
				<text><![CDATA[BIÊN LAI ĐỔI VÉ]]></text>
			</staticText>
			<textField>
				<reportElement x="380" y="0" width="170" height="20"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA["Mã GD: " + $P{p_MaGiaoDich}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="380" y="20" width="170" height="20"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA["Ngày: " + $P{p_NgayLap}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="10" y="0" width="250" height="20"/>
				<textFieldExpression><![CDATA["Nhân viên: " + $P{p_NhanVien}]]></textFieldExpression>
			</textField>
		</band>
	</title>

	<detail>
		<band height="240" splitType="Stretch">
			<rectangle>
				<reportElement x="0" y="10" width="555" height="170"/>
				<graphicElement>
					<pen lineWidth="0.5" lineStyle="Dashed"/>
				</graphicElement>
			</rectangle>

			<staticText>
				<reportElement x="10" y="20" width="150" height="20"/>
				<textElement verticalAlignment="Middle">
					<font fontName="SansSerif" isBold="true"/>
				</textElement>
				<text><![CDATA[Số lượng vé:]]></text>
			</staticText>
			<textField>
				<reportElement x="160" y="20" width="120" height="20"/>
				<textFieldExpression><![CDATA[$P{p_SoLuongVe}]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement x="10" y="40" width="540" height="15"/>
				<textElement verticalAlignment="Middle">
					<font fontName="SansSerif" isBold="true"/>
				</textElement>
				<text><![CDATA[Chi tiết đổi vé]]></text>
			</staticText>

			<staticText>
				<reportElement x="10" y="58" width="210" height="15"/>
				<textElement><font fontName="SansSerif" isBold="true"/></textElement>
				<text><![CDATA[Vé cũ (hành trình)]]></text>
			</staticText>
			<staticText>
				<reportElement x="230" y="58" width="60" height="15"/>
				<textElement textAlignment="Right"><font fontName="SansSerif" isBold="true"/></textElement>
				<text><![CDATA[Giá]]></text>
			</staticText>
			<staticText>
				<reportElement x="310" y="58" width="210" height="15"/>
				<textElement><font fontName="SansSerif" isBold="true"/></textElement>
				<text><![CDATA[Vé mới (hành trình)]]></text>
			</staticText>
			<staticText>
				<reportElement x="520" y="58" width="35" height="15"/>
				<textElement textAlignment="Right"><font fontName="SansSerif" isBold="true"/></textElement>
				<text><![CDATA[Giá]]></text>
			</staticText>

			<textField>
				<reportElement x="10" y="75" width="210" height="15" isPrintWhenDetailOverflows="true"/>
				<textFieldExpression><![CDATA[$F{oldRoute}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0 VNĐ">
				<reportElement x="230" y="75" width="60" height="15" isPrintWhenDetailOverflows="true"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA[$F{oldPrice}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="310" y="75" width="210" height="15" isPrintWhenDetailOverflows="true"/>
				<textFieldExpression><![CDATA[$F{newRoute}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0 VNĐ">
				<reportElement x="520" y="75" width="35" height="15" isPrintWhenDetailOverflows="true"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA[$F{newPrice}]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement x="10" y="100" width="150" height="20"/>
				<textElement verticalAlignment="Middle"/>
				<text><![CDATA[Tổng vé cũ:]]></text>
			</staticText>
			<textField pattern="#,##0 VNĐ">
				<reportElement x="160" y="100" width="120" height="20"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="SansSerif" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{p_TongVeCu}]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement x="10" y="125" width="150" height="20"/>
				<textElement verticalAlignment="Middle"/>
				<text><![CDATA[Tổng vé mới:]]></text>
			</staticText>
			<textField pattern="#,##0 VNĐ">
				<reportElement x="160" y="125" width="120" height="20"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="SansSerif" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{p_TongVeMoi}]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement x="10" y="150" width="150" height="20"/>
				<textElement verticalAlignment="Middle"/>
				<text><![CDATA[Phí đổi (mỗi vé):]]></text>
			</staticText>
			<textField pattern="#,##0 VNĐ">
				<reportElement x="160" y="150" width="120" height="20"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$P{p_PhiDoiMoiVe}]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement x="310" y="100" width="150" height="20"/>
				<textElement verticalAlignment="Middle"/>
				<text><![CDATA[Tổng phí đổi:]]></text>
			</staticText>
			<textField pattern="#,##0 VNĐ">
				<reportElement x="460" y="100" width="80" height="20"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="SansSerif" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{p_TongPhiDoi}]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement x="310" y="125" width="150" height="20"/>
				<textElement verticalAlignment="Middle"/>
				<text><![CDATA[Chênh lệch giá:]]></text>
			</staticText>
			<textField pattern="#,##0 VNĐ">
				<reportElement x="460" y="125" width="80" height="20"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$P{p_ChenhLechGia}]]></textFieldExpression>
			</textField>

			<staticText>
				<reportElement x="310" y="150" width="230" height="20"/>
				<textElement verticalAlignment="Middle"/>
				<text><![CDATA[Không hoàn tiền nếu âm]]></text>
			</staticText>

			<line>
				<reportElement x="0" y="190" width="555" height="1"/>
				<graphicElement>
					<pen lineWidth="1.0" lineStyle="Solid"/>
				</graphicElement>
			</line>

			<staticText>
				<reportElement x="310" y="190" width="150" height="30"/>
				<textElement verticalAlignment="Middle">
					<font fontName="SansSerif" size="14" isBold="true"/>
				</textElement>
				<text><![CDATA[THANH TOÁN:]]></text>
			</staticText>
			<textField pattern="#,##0 VNĐ">
				<reportElement x="460" y="190" width="80" height="30" forecolor="#FF0000"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="SansSerif" size="14" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{p_ThanhToan}]]></textFieldExpression>
			</textField>
		</band>
	</detail>

	<pageFooter>
		<band height="60" splitType="Stretch">
			<staticText>
				<reportElement x="20" y="10" width="150" height="20"/>
				<textElement textAlignment="Center">
					<font fontName="SansSerif" isBold="true"/>
				</textElement>
				<text><![CDATA[Khách hàng]]></text>
			</staticText>
			<staticText>
				<reportElement x="20" y="30" width="150" height="20"/>
				<textElement textAlignment="Center">
					<font fontName="SansSerif" isItalic="true"/>
				</textElement>
				<text><![CDATA[(Ký, ghi rõ họ tên)]]></text>
			</staticText>
			<staticText>
				<reportElement x="380" y="10" width="150" height="20"/>
				<textElement textAlignment="Center">
					<font fontName="SansSerif" isBold="true"/>
				</textElement>
				<text><![CDATA[Nhân viên lập phiếu]]></text>
			</staticText>
		</band>
	</pageFooter>
</jasperReport>
