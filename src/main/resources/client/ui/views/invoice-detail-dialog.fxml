<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="vn.edu.iuh.fit.client.controller.InvoiceDetailDialogController"
           stylesheets="@../css/invoice-management-styles.css"
           prefWidth="960"
           prefHeight="660">

    <VBox spacing="12">
        <padding><Insets top="20" right="24" bottom="16" left="24"/></padding>

        <!-- Dialog title row -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="Chi tiết Hoá đơn" styleClass="dialog-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblInvoiceType" text="SALE"
                   style="-fx-font-size:12px; -fx-font-weight:800; -fx-padding: 4 12; -fx-background-radius:999;"/>
        </HBox>

        <!-- Header info grid -->
        <GridPane hgap="16" vgap="6">
            <columnConstraints>
                <ColumnConstraints minWidth="110" prefWidth="110"/>
                <ColumnConstraints hgrow="ALWAYS"/>
                <ColumnConstraints minWidth="110" prefWidth="110"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <!-- Row 0: Mã HĐ | Ngày phát sinh -->
            <Label text="Mã hoá đơn:" styleClass="dialog-field-label"
                   GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label fx:id="lblInvoiceId" styleClass="dialog-field-value"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="Ngày phát sinh:" styleClass="dialog-field-label"
                   GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <Label fx:id="lblIssueDate" styleClass="dialog-field-value"
                   GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <!-- Row 1: Khách hàng | Nhân viên -->
            <Label text="Khách hàng:" styleClass="dialog-field-label"
                   GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <Label fx:id="lblCustomer" styleClass="dialog-field-value"
                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label text="Nhân viên:" styleClass="dialog-field-label"
                   GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <Label fx:id="lblEmployee" styleClass="dialog-field-value"
                   GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <!-- Row 2: SĐT | Tổng tiền -->
            <Label text="SĐT khách:" styleClass="dialog-field-label"
                   GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <Label fx:id="lblPhone" styleClass="dialog-field-value"
                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <Label text="Tổng tiền:" styleClass="dialog-field-label"
                   GridPane.columnIndex="2" GridPane.rowIndex="2"/>
            <Label fx:id="lblTotalAmount"
                   style="-fx-font-size:14px; -fx-font-weight:800; -fx-text-fill: -primary;"
                   GridPane.columnIndex="3" GridPane.rowIndex="2"/>

            <!-- Row 3: VAT info (hidden if null) -->
            <Label fx:id="lblVatLabel" text="Thông tin VAT:" styleClass="dialog-field-label"
                   GridPane.columnIndex="0" GridPane.rowIndex="3" visible="false" managed="false"/>
            <Label fx:id="lblVatInfo" styleClass="dialog-field-value"
                   GridPane.columnIndex="1" GridPane.rowIndex="3" visible="false" managed="false"
                   GridPane.columnSpan="3"/>
        </GridPane>

        <Separator/>

        <!-- Line items table -->
        <Label text="Danh sách vé" styleClass="dialog-section-title"/>

        <TableView fx:id="tableItems" styleClass="data-table" VBox.vgrow="ALWAYS">
            <VBox.margin><Insets/></VBox.margin>
            <columns>
                <TableColumn text="Hành khách" fx:id="colPassenger" prefWidth="150"/>
                <TableColumn text="CCCD" fx:id="colIdCard" prefWidth="110"/>
                <TableColumn text="Đối tượng" fx:id="colTicketType" prefWidth="90"/>
                <TableColumn text="Tàu" fx:id="colTrain" prefWidth="80"/>
                <TableColumn text="Toa/Ghế" fx:id="colSeat" prefWidth="75"/>
                <TableColumn text="Tuyến đường" fx:id="colRoute" prefWidth="180"/>
                <TableColumn text="Giờ đi" fx:id="colDepartTime" prefWidth="130"/>
                <TableColumn text="Giá gốc" fx:id="colSubTotal" prefWidth="100"/>
                <TableColumn text="Giảm giá" fx:id="colDiscount" prefWidth="90"/>
                <TableColumn text="Bảo hiểm" fx:id="colInsurance" prefWidth="85"/>
                <TableColumn text="Thành tiền" fx:id="colFinal" prefWidth="110"/>
                <TableColumn text="Trạng thái" fx:id="colStatus" prefWidth="100"/>
            </columns>
            <placeholder>
                <Label text="Không có dữ liệu vé trong hoá đơn này"/>
            </placeholder>
        </TableView>

        <!-- EXCHANGE original ticket section -->
        <VBox fx:id="paneExchange" visible="false" managed="false"
              styleClass="exchange-section" spacing="6">
            <Label text="🔄 Thông tin vé cũ đã thu hồi (Đổi vé)" styleClass="exchange-section-title"/>
            <GridPane hgap="16" vgap="4">
                <columnConstraints>
                    <ColumnConstraints minWidth="110" prefWidth="110"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints minWidth="110" prefWidth="110"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>
                <Label text="Tàu cũ:" styleClass="dialog-field-label"
                       GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Label fx:id="lblOrigTrain" styleClass="dialog-field-value"
                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="Toa/Ghế cũ:" styleClass="dialog-field-label"
                       GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <Label fx:id="lblOrigSeat" styleClass="dialog-field-value"
                       GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                <Label text="Tuyến cũ:" styleClass="dialog-field-label"
                       GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Label fx:id="lblOrigRoute" styleClass="dialog-field-value"
                       GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.columnSpan="3"/>
                <Label text="Giờ khởi hành:" styleClass="dialog-field-label"
                       GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <Label fx:id="lblOrigDepartTime" styleClass="dialog-field-value"
                       GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            </GridPane>
        </VBox>

        <!-- Footer buttons -->
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button text="🖨  In hoá đơn" fx:id="btnPrint"
                    styleClass="primary-button"
                    onAction="#handlePrint"/>
            <Button text="Đóng" fx:id="btnClose"
                    styleClass="secondary-button"
                    onAction="#handleClose"/>
        </HBox>
    </VBox>

    <!-- Loading overlay -->
    <StackPane fx:id="loadingOverlay"
               visible="false"
               managed="false"
               maxWidth="Infinity"
               maxHeight="Infinity"
               style="-fx-background-color: rgba(0,0,0,0.35);">
        <VBox alignment="CENTER" spacing="10"
              maxWidth="260"
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 24; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.15),18,0,0,6);">
            <ProgressIndicator prefWidth="48" prefHeight="48"/>
            <Label text="Đang tải chi tiết..." style="-fx-font-size: 13px; -fx-text-fill: #5b6775;"/>
        </VBox>
    </StackPane>

</StackPane>
