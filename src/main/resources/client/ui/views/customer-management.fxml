<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>



<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="vn.edu.iuh.fit.client.controller.CustomerManagementController"
           stylesheets="@../css/styles.css"
           prefWidth="1200" prefHeight="700">

<BorderPane>

    <!-- Main Content -->
    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>

            <!-- ================== PHẦN HEADER ĐÃ ĐƯỢC SỬA LẠI ================== -->
	            <HBox alignment="CENTER_LEFT" spacing="15">
	                <Label text="Quản Lý Khách Hàng" styleClass="page-title"/>
	                <Region HBox.hgrow="ALWAYS"/>
	                <TextField fx:id="searchField" promptText="Tìm theo tên, CCCD/hộ chiếu, SĐT, email..." prefWidth="300"/>
	                <Button fx:id="btnSearch" text="Tìm kiếm" styleClass="primary-button"/>
	                <!-- Lưu ý: Tôi đã đổi tên nút từ "hóa đơn" sang "khách hàng" cho đúng ngữ cảnh -->
	                <Button fx:id="btnShowAll" text="Hiển thị tất cả" styleClass="secondary-button"/>
	            </HBox>

            <TableView fx:id="customerTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="idColumn" text="Mã Khách hàng" minWidth="120"/>
                    <TableColumn fx:id="nameColumn" text="Họ tên" minWidth="200"/>
                    <TableColumn fx:id="cccdColumn" text="CCCD" minWidth="150"/>
                    <TableColumn fx:id="passportColumn" text="Hộ chiếu" minWidth="150"/>
                    <TableColumn fx:id="phoneColumn" text="Số điện thoại" minWidth="150"/>
                    <TableColumn fx:id="pointsColumn" text="Điểm tích" minWidth="100"/>
                </columns>
            </TableView>

            <HBox alignment="CENTER" spacing="10">
                <Pagination fx:id="pagination" maxPageIndicatorCount="5" />
            </HBox>

            <!-- ================== PHẦN FOOTER ĐÃ ĐƯỢC SỬA LẠI ================== -->
	            <HBox alignment="CENTER_LEFT" spacing="15">
	                <Label fx:id="customerCountLabel" styleClass="field-label-bold"/>
	                <Region HBox.hgrow="ALWAYS"/>
	                <Button fx:id="btnRefresh" text="Làm mới" styleClass="secondary-button"/>
	                <Button fx:id="btnCustomerHistory" text="Xem lịch sử mua vé" styleClass="secondary-button"/>
	                <Button fx:id="btnAddCustomer" text="Thêm" styleClass="add-button"/>
	                <Button fx:id="btnEditCustomer" text="Sửa" styleClass="primary-button"/>
	                <Button fx:id="btnDeleteCustomer" text="Xóa" styleClass="danger-button"/>
	            </HBox>

        </VBox>
    </center>
</BorderPane>

    <StackPane fx:id="loadingOverlay" visible="false" style="-fx-background-color: rgba(0, 0, 0, 0.5);">
        <ProgressIndicator maxWidth="60" maxHeight="60"/>
    </StackPane>

</StackPane>
