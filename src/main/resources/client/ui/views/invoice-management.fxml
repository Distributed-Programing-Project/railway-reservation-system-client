<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="vn.edu.iuh.fit.client.controller.InvoiceManagementController"
           stylesheets="@../css/invoice-management-styles.css">

    <VBox spacing="12"
          maxWidth="Infinity"
          maxHeight="Infinity">

        <!-- Header -->
        <HBox styleClass="page-header"
              alignment="CENTER_LEFT"
              spacing="12"
              maxWidth="Infinity">
            <padding>
                <Insets top="12" right="18" bottom="12" left="18"/>
            </padding>
            <Label text="Quản lý Hoá đơn" styleClass="page-title"/>
        </HBox>

        <!-- Filter bar -->
        <HBox styleClass="filter-bar"
              alignment="CENTER_LEFT"
              spacing="10"
              maxWidth="Infinity">
            <padding>
                <Insets left="18" right="18"/>
            </padding>

            <TextField fx:id="txtKeyword"
                       promptText="Tìm mã HĐ hoặc tên khách hàng..."
                       styleClass="text-field"
                       prefWidth="360"
                       maxWidth="Infinity"
                       minHeight="38"
                       HBox.hgrow="ALWAYS"/>

            <Separator orientation="VERTICAL" prefHeight="30"/>

            <Label text="Ngày:" styleClass="filter-label"/>
            <ComboBox fx:id="cmbDay"
                      styleClass="filter-combo"
                      prefWidth="105"
                      minWidth="100"
                      minHeight="38"
                      visibleRowCount="10"/>

            <Label text="Tháng:" styleClass="filter-label"/>
            <ComboBox fx:id="cmbMonth"
                      styleClass="filter-combo"
                      prefWidth="110"
                      minWidth="105"
                      minHeight="38"
                      visibleRowCount="10"/>

            <Label text="Năm:" styleClass="filter-label"/>
            <ComboBox fx:id="cmbYear"
                      styleClass="filter-combo"
                      prefWidth="120"
                      minWidth="115"
                      minHeight="38"
                      visibleRowCount="8"/>

            <Separator orientation="VERTICAL" prefHeight="30"/>

            <Label text="Loại:" styleClass="filter-label"/>
            <ComboBox fx:id="cmbType"
                      styleClass="filter-combo"
                      prefWidth="220"
                      minWidth="200"
                      minHeight="38"
                      visibleRowCount="6"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Lọc"
                    fx:id="btnSearch"
                    minWidth="64"
                    minHeight="38"
                    styleClass="primary-button"
                    onAction="#handleSearch"/>

            <Button text="Làm mới"
                    fx:id="btnRefresh"
                    minWidth="82"
                    minHeight="38"
                    styleClass="secondary-button"
                    onAction="#handleRefresh"/>
        </HBox>

        <!-- Table -->
        <VBox VBox.vgrow="ALWAYS"
              spacing="0"
              maxWidth="Infinity"
              maxHeight="Infinity">
            <padding>
                <Insets left="18" right="18"/>
            </padding>

            <TableView fx:id="tableView"
                       styleClass="data-table"
                       VBox.vgrow="ALWAYS"
                       maxWidth="Infinity"
                       maxHeight="Infinity"
                       fixedCellSize="44">
                <columns>
                    <TableColumn text="Mã HĐ" fx:id="colId" prefWidth="145" minWidth="110"/>
                    <TableColumn text="Khách hàng" fx:id="colCustomer" prefWidth="200" minWidth="140"/>
                    <TableColumn text="Nhân viên" fx:id="colEmployee" prefWidth="165" minWidth="120"/>
                    <TableColumn text="Ngày phát sinh" fx:id="colDate" prefWidth="165" minWidth="140"/>
                    <TableColumn text="Loại" fx:id="colType" prefWidth="110" minWidth="90"/>
                    <TableColumn text="Số vé" fx:id="colCount" prefWidth="75" minWidth="60"/>
                    <TableColumn text="Tổng tiền" fx:id="colAmount" prefWidth="145" minWidth="120"/>
                    <TableColumn text="Thao tác" fx:id="colActions" prefWidth="210" minWidth="200"/>
                </columns>
                <placeholder>
                    <Label text="Không có hoá đơn nào phù hợp với tiêu chí đã chọn"/>
                </placeholder>
            </TableView>
        </VBox>

        <!-- Pagination -->
        <HBox styleClass="pagination-bar"
              alignment="CENTER"
              spacing="18"
              maxWidth="Infinity">
            <padding>
                <Insets bottom="12"/>
            </padding>

            <Button text="◄"
                    fx:id="btnPrev"
                    minWidth="42"
                    minHeight="34"
                    styleClass="secondary-button"
                    onAction="#handlePrevPage"/>

            <Label fx:id="lblPage"
                   text="1 / 1"
                   styleClass="page-label"/>

            <Button text="►"
                    fx:id="btnNext"
                    minWidth="42"
                    minHeight="34"
                    styleClass="secondary-button"
                    onAction="#handleNextPage"/>
        </HBox>
    </VBox>

    <!-- Loading overlay -->
    <StackPane fx:id="loadingOverlay"
               visible="false"
               managed="false"
               maxWidth="Infinity"
               maxHeight="Infinity"
               style="-fx-background-color: rgba(0,0,0,0.35);">

        <VBox alignment="CENTER"
              spacing="10"
              maxWidth="260"
              style="-fx-background-color: white;
                     -fx-background-radius: 10;
                     -fx-padding: 24;
                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.15),18,0,0,6);">

            <ProgressIndicator prefWidth="48" prefHeight="48"/>
            <Label text="Đang tải..."
                   style="-fx-font-size: 13px; -fx-text-fill: #5b6775;"/>
        </VBox>
    </StackPane>

</StackPane>
