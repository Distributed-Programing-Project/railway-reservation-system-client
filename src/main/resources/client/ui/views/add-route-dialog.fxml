<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="vn.edu.iuh.fit.client.controller.AddRouteDialogController"
      stylesheets="@../css/styles.css"
      spacing="14" prefWidth="680" prefHeight="640">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label fx:id="titleLabel" text="Thêm tuyến đường" styleClass="page-title"/>
    <Separator/>

    <GridPane hgap="12" vgap="12">
        <Label text="Mã tuyến:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="routeCodeField" promptText="VD: HN-DN" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Giá cơ bản:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <TextField fx:id="priceBasicField" promptText="0" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

        <Label text="Ga đi:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="departureStationCombo" maxWidth="Infinity" promptText="Chọn ga đi"
                  GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Ga đến:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <ComboBox fx:id="destinationStationCombo" maxWidth="Infinity" promptText="Chọn ga đến"
                  GridPane.columnIndex="3" GridPane.rowIndex="1"/>
    </GridPane>

    <VBox spacing="8" VBox.vgrow="ALWAYS">
        <Label text="Ga dừng trung gian"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <ComboBox fx:id="stopStationCombo" promptText="Chọn ga dừng" prefWidth="260"/>
            <Button fx:id="btnAddStop" text="Thêm" onAction="#handleAddStop" styleClass="secondary-button"/>
            <Button fx:id="btnRemoveStop" text="Xoá" onAction="#handleRemoveStop" styleClass="danger-button"/>
            <Button fx:id="btnMoveStopUp" text="Lên" onAction="#handleMoveStopUp" styleClass="secondary-button"/>
            <Button fx:id="btnMoveStopDown" text="Xuống" onAction="#handleMoveStopDown" styleClass="secondary-button"/>
        </HBox>

        <TableView fx:id="stopsTable" VBox.vgrow="ALWAYS" styleClass="data-table">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="stopOrderColumn" text="Thứ tự" minWidth="80"/>
                <TableColumn fx:id="stopStationColumn" text="Ga dừng" minWidth="260"/>
            </columns>
        </TableView>
    </VBox>

    <VBox spacing="4">
        <Label text="Đường đi"/>
        <Label fx:id="pathPreviewLabel" text="" wrapText="true" styleClass="page-label"/>
        <Label fx:id="errorLabel" text="" wrapText="true" style="-fx-text-fill: #c0392b; -fx-font-weight: 700;"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnCancel" text="Hủy" onAction="#handleCancel" prefWidth="100" styleClass="secondary-button"/>
        <Button fx:id="btnSave" text="Lưu" onAction="#handleSave" prefWidth="100" styleClass="primary-button"/>
    </HBox>
</VBox>
