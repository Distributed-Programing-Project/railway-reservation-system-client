<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="vn.edu.iuh.fit.client.controller.ScheduleDetailPriceDialogController"
      stylesheets="@../css/schedule-management.css"
      spacing="14" prefWidth="820" prefHeight="620">

    <padding>
        <Insets top="18" right="18" bottom="18" left="18"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="4">
            <Label fx:id="titleLabel" text="Chi tiết giá ghế" styleClass="title-2"/>
            <Label fx:id="scheduleInfoLabel" text="" styleClass="text-caption"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <TextField fx:id="bulkPriceField" promptText="Giá áp dụng" prefWidth="150"/>
        <Button fx:id="btnApplyBulk" text="Áp dụng tất cả" onAction="#handleApplyBulk" styleClass="accent"/>
    </HBox>

    <TableView fx:id="detailTable" VBox.vgrow="ALWAYS" editable="true" styleClass="striped">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="segmentColumn" text="Chặng" prefWidth="190"/>
            <TableColumn fx:id="carriageColumn" text="Toa" prefWidth="70"/>
            <TableColumn fx:id="seatColumn" text="Ghế" prefWidth="70"/>
            <TableColumn fx:id="typeColumn" text="Loại ghế" prefWidth="210"/>
            <TableColumn fx:id="priceColumn" text="Giá vé" prefWidth="160"/>
            <TableColumn fx:id="statusColumn" text="Trạng thái" prefWidth="120"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="btnRefresh" text="Làm mới" onAction="#handleRefresh" styleClass="button-flat"/>
        <Button text="Đóng" onAction="#handleClose" styleClass="button-outlined"/>
        <Button fx:id="btnSave" text="Lưu giá vé" onAction="#handleSave" styleClass="success"/>
    </HBox>
</VBox>
