<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" style="-fx-background-color: #f4f6f8; -fx-padding: 20;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vn.edu.iuh.fit.client.controller.ExchangeTicketSearchController">
   <children>
      <Label text="TRA CỨU VÉ ĐỂ ĐỔI" textFill="#0066cc">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      
      <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #d5dde6; -fx-border-radius: 8;">
         <children>
            <Label text="Nhập CCCD / Hộ chiếu:" />
            <TextField fx:id="txtSearchCCCD" prefWidth="300.0" promptText="Mã vé / QR / CCCD / Hộ chiếu / Mã khách hàng" />
            <Button fx:id="btnTimKiem" mnemonicParsing="false" style="-fx-background-color: #0066cc; -fx-text-fill: white;" text="Tìm kiếm" />
         </children>
      </HBox>

      <TableView fx:id="tblDanhSachVe" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colMaVe" prefWidth="120.0" text="Mã Vé" />
          <TableColumn fx:id="colTau" prefWidth="80.0" text="Tàu" />
          <TableColumn fx:id="colHanhTrinh" prefWidth="200.0" text="Hành Trình" />
          <TableColumn fx:id="colGhe" prefWidth="120.0" text="Ghế" />
          <TableColumn fx:id="colGiaVe" prefWidth="120.0" text="Giá Vé Gốc" />
          <TableColumn fx:id="colLyDo" prefWidth="200.0" text="Điều kiện" />
        </columns>
      </TableView>

      <HBox alignment="CENTER_RIGHT">
         <children>
            <Button fx:id="btnTienHanhDoi" disable="true" mnemonicParsing="false" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20;" text="TIẾN HÀNH CHỌN CHUYẾN MỚI" />
         </children>
      </HBox>
   </children>
</VBox>
