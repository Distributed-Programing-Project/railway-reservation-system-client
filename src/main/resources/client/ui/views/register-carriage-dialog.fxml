<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="vn.edu.iuh.fit.client.controller.RegisterCarriageDialogController"
      stylesheets="@../css/train-management.css"
      spacing="18"
      prefWidth="420"
      minWidth="420"
      prefHeight="350"
      minHeight="350"
      style="-fx-padding: 24;">

    <Label text="Đăng ký toa mới" styleClass="dialog-title"/>

    <Separator/>

    <GridPane hgap="12" vgap="14" VBox.vgrow="ALWAYS">
        <columnConstraints>
            <ColumnConstraints minWidth="110" prefWidth="110"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Loại toa:"
               styleClass="field-label"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>

        <ComboBox fx:id="cmbCarriageType"
                  styleClass="filter-combo"
                  maxWidth="Infinity"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="0"/>

        <Label text="Số ghế:"
               styleClass="field-label"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>

        <Label fx:id="lblSeatPreview"
               styleClass="text-sm"
               wrapText="true"
               maxWidth="Infinity"
               GridPane.columnIndex="1"
               GridPane.rowIndex="1"/>
    </GridPane>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="btnCancel"
                text="Hủy"
                styleClass="secondary-button"
                minWidth="80"
                onAction="#handleCancel"/>

        <Button fx:id="btnSave"
                text="Lưu"
                styleClass="primary-button"
                minWidth="80"
                onAction="#handleSave"/>
    </HBox>

</VBox>