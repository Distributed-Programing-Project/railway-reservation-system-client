<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="vn.edu.iuh.fit.client.controller.AddEmployeeDialogController"
      stylesheets="@../css/employee-management-styles.css"
      spacing="18"
      prefWidth="520"
      style="-fx-padding: 24; -fx-background-color: white;">

    <Label text="Thêm nhân viên mới" styleClass="dialog-title"/>

    <GridPane hgap="12" vgap="12">
        <columnConstraints>
            <ColumnConstraints minWidth="140" prefWidth="140"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <!-- Họ tên -->
        <Label text="Họ tên: *" styleClass="field-label"
               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtName" promptText="Nhập họ tên đầy đủ"
                   styleClass="text-field"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <!-- CCCD -->
        <Label text="CCCD: *" styleClass="field-label"
               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtNationalId" promptText="9 hoặc 12 chữ số"
                   styleClass="text-field"
                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <!-- Ngày sinh -->
        <Label text="Ngày sinh: *" styleClass="field-label"
               GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <DatePicker fx:id="dpDateOfBirth" promptText="dd/MM/yyyy"
                    styleClass="filter-combo"
                    GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <!-- Giới tính -->
        <Label text="Giới tính: *" styleClass="field-label"
               GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <ComboBox fx:id="comboGender" promptText="Chọn giới tính"
                  styleClass="filter-combo" maxWidth="Infinity"
                  GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <!-- Địa chỉ -->
        <Label text="Địa chỉ:" styleClass="field-label"
               GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <TextField fx:id="txtAddress" promptText="Địa chỉ thường trú (tùy chọn)"
                   styleClass="text-field"
                   GridPane.columnIndex="1" GridPane.rowIndex="4"/>

        <!-- Số điện thoại -->
        <Label text="Số điện thoại: *" styleClass="field-label"
               GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <TextField fx:id="txtPhone" promptText="10 chữ số"
                   styleClass="text-field"
                   GridPane.columnIndex="1" GridPane.rowIndex="5"/>

        <!-- Email -->
        <Label text="Email: *" styleClass="field-label"
               GridPane.columnIndex="0" GridPane.rowIndex="6"/>
        <TextField fx:id="txtEmail" promptText="example@email.com"
                   styleClass="text-field"
                   GridPane.columnIndex="1" GridPane.rowIndex="6"/>

        <!-- Loại nhân viên -->
        <Label text="Loại nhân viên: *" styleClass="field-label"
               GridPane.columnIndex="0" GridPane.rowIndex="7"/>
        <ComboBox fx:id="comboType" promptText="Chọn loại"
                  styleClass="filter-combo" maxWidth="Infinity"
                  GridPane.columnIndex="1" GridPane.rowIndex="7"/>
    </GridPane>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="btnCancel" text="Hủy"
                styleClass="secondary-button" onAction="#handleCancel"/>
        <Button fx:id="btnSave" text="Lưu nhân viên"
                styleClass="primary-button" onAction="#handleSave"/>
    </HBox>

</VBox>
