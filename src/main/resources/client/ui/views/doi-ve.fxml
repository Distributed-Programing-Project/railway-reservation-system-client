<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="vn.edu.iuh.fit.client.controller.ExchangeTicketController"
           stylesheets="@../css/styles.css"
           prefWidth="1200" prefHeight="700">

    <BorderPane>
        <center>
            <VBox spacing="14" styleClass="main-content" maxWidth="Infinity">
                <padding>
                    <Insets top="18" right="18" bottom="18" left="18"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Đổi Vé Tàu" styleClass="page-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnResetAll" text="Làm mới" styleClass="secondary-button"/>
                </HBox>

                <HBox alignment="CENTER" spacing="12">
                    <Label fx:id="lblStep1" text="Bước 1: Vé cũ" styleClass="secondary-button"/>
                    <Label fx:id="lblStep2" text="Bước 2: Ghế mới" styleClass="secondary-button"/>
                    <Label fx:id="lblStep3" text="Bước 3: Tính phí" styleClass="secondary-button"/>
                    <Label fx:id="lblStep4" text="Bước 4: Hoàn tất" styleClass="secondary-button"/>
                </HBox>

                <StackPane VBox.vgrow="ALWAYS">

                    <!-- STEP 1 -->
                    <VBox fx:id="step1Pane" spacing="12" visible="true" managed="true" VBox.vgrow="ALWAYS">
                        <TitledPane text="Tra cứu vé cũ" expanded="true" collapsible="false">
                            <content>
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <TextField fx:id="txtIdCard" promptText="Nhập CCCD / Hộ chiếu..." HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="btnSearchOldTickets" text="Tìm vé" styleClass="primary-button"/>
                                </HBox>
                            </content>
                        </TitledPane>

                        <TableView fx:id="tblOldTickets" VBox.vgrow="ALWAYS" styleClass="data-table">
                            <columns>
                                <TableColumn fx:id="colSelect" text="Chọn" prefWidth="60"/>
                                <TableColumn fx:id="colOldTicketId" text="Mã vé" prefWidth="120"/>
                                <TableColumn fx:id="colOldTrain" text="Tàu" prefWidth="80"/>
                                <TableColumn fx:id="colOldRoute" text="Hành trình" prefWidth="220"/>
                                <TableColumn fx:id="colOldDeparture" text="Giờ đi" prefWidth="140"/>
                                <TableColumn fx:id="colOldSeat" text="Ghế" prefWidth="100"/>
                                <TableColumn fx:id="colOldPrice" text="Giá vé" prefWidth="120"/>
                                <TableColumn fx:id="colEligible" text="OK" prefWidth="60"/>
                                <TableColumn fx:id="colReason" text="Lý do" prefWidth="260"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>

                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label fx:id="lblOldSelectedCount" text="Đã chọn: 0"/>
                            <Region HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </VBox>

                    <!-- STEP 2 -->
                    <VBox fx:id="step2Pane" spacing="12" visible="false" managed="false" VBox.vgrow="ALWAYS">
                        <TitledPane text="Tìm chuyến mới" expanded="true" collapsible="false">
                            <content>
                                <GridPane hgap="10" vgap="10">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="12"/>
                                        <ColumnConstraints percentWidth="28"/>
                                        <ColumnConstraints percentWidth="12"/>
                                        <ColumnConstraints percentWidth="28"/>
                                        <ColumnConstraints percentWidth="20"/>
                                    </columnConstraints>
                                    <children>
                                        <Label text="Ga đi:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                        <ComboBox fx:id="cbDepartureStation" promptText="Chọn ga đi" styleClass="filter-combo"
                                                  GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                        <Label text="Ga đến:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                                        <ComboBox fx:id="cbDestinationStation" promptText="Chọn ga đến" styleClass="filter-combo"
                                                  GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                                        <Label text="Ngày đi:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                        <DatePicker fx:id="dpDepartureDate" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                                        <Button fx:id="btnSearchSchedules" text="Tìm chuyến" styleClass="primary-button"
                                                GridPane.columnIndex="4" GridPane.rowIndex="1"/>
                                    </children>
                                </GridPane>
                            </content>
                        </TitledPane>

                        <HBox spacing="12" VBox.vgrow="ALWAYS">
                            <VBox spacing="10" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                                <Label text="Danh sách chuyến"/>
                                <TableView fx:id="tblSchedules" VBox.vgrow="ALWAYS" styleClass="data-table">
                                    <columns>
                                        <TableColumn fx:id="colScheduleTrain" text="Tàu" prefWidth="80"/>
                                        <TableColumn fx:id="colScheduleRoute" text="Hành trình" prefWidth="220"/>
                                        <TableColumn fx:id="colScheduleDeparture" text="Giờ đi" prefWidth="140"/>
                                        <TableColumn fx:id="colScheduleArrival" text="Giờ đến" prefWidth="140"/>
                                        <TableColumn fx:id="colScheduleSeats" text="Còn" prefWidth="60"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                </TableView>
                            </VBox>

                            <VBox spacing="10" prefWidth="520" VBox.vgrow="ALWAYS">
                                <Label text="Chọn ghế mới"/>
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label text="Toa:"/>
                                    <ComboBox fx:id="cbCarriage" styleClass="filter-combo" prefWidth="280"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="lblSeatSelectedCount" text="Ghế đã chọn: 0 / 0"/>
                                </HBox>

                                <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS">
                                    <content>
                                        <GridPane fx:id="gridSeats" hgap="8" vgap="8"/>
                                    </content>
                                </ScrollPane>

                                <Label text="Ghế đã giữ chỗ"/>
                                <TableView fx:id="tblSelectedSeats" prefHeight="160" styleClass="data-table">
                                    <columns>
                                        <TableColumn fx:id="colNewSeat" text="Ghế" prefWidth="220"/>
                                        <TableColumn fx:id="colNewPrice" text="Giá" prefWidth="120"/>
                                        <TableColumn fx:id="colNewAction" text="" prefWidth="80"/>
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                                    </columnResizePolicy>
                                </TableView>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- STEP 3 -->
                    <VBox fx:id="step3Pane" spacing="12" visible="false" managed="false" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="Tính phí &amp; xác nhận" style="-fx-font-weight: bold;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="btnPreviewFee" text="Tính phí" styleClass="secondary-button"/>
                        </HBox>

                        <GridPane hgap="10" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="22"/>
                                <ColumnConstraints percentWidth="28"/>
                                <ColumnConstraints percentWidth="22"/>
                                <ColumnConstraints percentWidth="28"/>
                            </columnConstraints>
                            <children>
                                <Label text="Tổng vé cũ:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <Label fx:id="lblTotalOld" text="--" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                <Label text="Tổng vé mới:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                                <Label fx:id="lblTotalNew" text="--" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                                <Label text="Phí đổi:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <Label fx:id="lblFeeTotal" text="--" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                                <Label text="Chênh lệch:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                                <Label fx:id="lblDiff" text="--" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                                <Label text="Tổng thanh toán:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                <Label fx:id="lblTotalAmount" text="--" style="-fx-font-weight: 800;" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                            </children>
                        </GridPane>

                        <Separator/>

                        <TitledPane text="Thông tin VAT (tuỳ chọn)" expanded="true" collapsible="false">
                            <content>
                                <GridPane hgap="10" vgap="10">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="20"/>
                                        <ColumnConstraints percentWidth="30"/>
                                        <ColumnConstraints percentWidth="20"/>
                                        <ColumnConstraints percentWidth="30"/>
                                    </columnConstraints>
                                    <children>
                                        <Label text="MST:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                        <TextField fx:id="txtVatTaxCode" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                        <Label text="Công ty:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                                        <TextField fx:id="txtVatCompanyName" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                                    </children>
                                </GridPane>
                            </content>
                        </TitledPane>

                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <CheckBox fx:id="chkPaymentConfirmed" text="Đã thu/hoàn tiền cho khách"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblExchangeStatus" text=""/>
                            <Button fx:id="btnConfirmExchange" text="Xác nhận đổi vé" styleClass="primary-button"/>
                        </HBox>
                    </VBox>

                    <!-- STEP 4 -->
                    <VBox fx:id="step4Pane" spacing="12" visible="false" managed="false" VBox.vgrow="ALWAYS">
                        <Label text="Đổi vé thành công" style="-fx-font-weight: 800; -fx-font-size: 18px;"/>
                        <GridPane hgap="10" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="18"/>
                                <ColumnConstraints percentWidth="82"/>
                            </columnConstraints>
                            <children>
                                <Label text="Invoice ID:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <Label fx:id="lblInvoiceId" text="--" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                                <Label text="Tổng tiền:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <Label fx:id="lblFinalAmount" text="--" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            </children>
                        </GridPane>

                        <HBox spacing="12">
                            <Button fx:id="btnPrintNewTickets" text="In vé mới" styleClass="primary-button"/>
                            <Button fx:id="btnPrintExchangeInvoice" text="In biên lai" styleClass="secondary-button"/>
                        </HBox>
                    </VBox>
                </StackPane>

                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Button fx:id="btnBack" text="Quay lại" styleClass="secondary-button"/>
                    <Button fx:id="btnNext" text="Tiếp tục" styleClass="primary-button"/>
                </HBox>
            </VBox>
        </center>
    </BorderPane>

    <StackPane fx:id="loadingOverlay" visible="false" managed="false" style="-fx-background-color: rgba(0,0,0,0.22);">
        <VBox alignment="CENTER" spacing="10">
            <ProgressIndicator/>
            <Label text="Đang xử lý..." style="-fx-text-fill: white; -fx-font-weight: 700;"/>
        </VBox>
    </StackPane>
</StackPane>

