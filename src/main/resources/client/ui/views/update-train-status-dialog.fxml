<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="vn.edu.iuh.fit.client.controller.UpdateTrainStatusDialogController"
      stylesheets="@../css/train-management.css"
      spacing="18"
      prefWidth="400"
      minWidth="400"
      prefHeight="350"
      minHeight="350"
      style="-fx-padding: 24;">

    <Label text="Đổi trạng thái tàu" styleClass="dialog-title"/>

    <Separator/>

    <VBox spacing="8" styleClass="box-section">
        <Label fx:id="lblTrainCode" styleClass="text-lg"/>
        <Label fx:id="lblCurrentStatus" styleClass="text-sm"/>
    </VBox>

    <GridPane hgap="12" vgap="14">
        <columnConstraints>
            <ColumnConstraints minWidth="130" prefWidth="130"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Trạng thái mới:"
               styleClass="field-label"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>

        <ComboBox fx:id="cmbNewStatus"
                  styleClass="filter-combo"
                  maxWidth="Infinity"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="0"/>
    </GridPane>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="btnCancel"
                text="Hủy"
                minWidth="80"
                styleClass="secondary-button"
                onAction="#handleCancel"/>

        <Button fx:id="btnSave"
                text="Xác nhận"
                minWidth="100"
                styleClass="primary-button"
                onAction="#handleSave"/>
    </HBox>

</VBox>