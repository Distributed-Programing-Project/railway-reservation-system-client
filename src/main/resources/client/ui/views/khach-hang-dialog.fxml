<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="vn.edu.iuh.fit.client.controller.KhachHangDialogController"
      spacing="20" prefWidth="520" styleClass="dialog-content">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label fx:id="titleLabel" text="Thêm khách hàng" styleClass="dialog-title"/>

    <GridPane hgap="15" vgap="15">
        <!-- Row 0: Customer ID (edit only) -->
        <Label fx:id="customerIdLabel" text="Mã KH:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="customerIdField" editable="false" focusTraversable="false" prefHeight="35"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <!-- Row 1: Full name -->
        <Label text="Họ và tên:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="nameField" promptText="Nhập họ và tên" prefHeight="35"
                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <!-- Row 2: Foreigner? -->
        <Label text="Quốc tịch:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <CheckBox fx:id="isForeignerCheckBox" text="Là người nước ngoài" styleClass="form-checkbox"
                  GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <!-- Row 3: CCCD / Passport -->
        <Label fx:id="idLabel" text="Số CCCD:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="idField" promptText="Nhập số CCCD" prefHeight="35"
                   GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <!-- Row 4: Phone -->
        <Label text="Số điện thoại:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <TextField fx:id="phoneField" promptText="Nhập số điện thoại" prefHeight="35"
                   GridPane.columnIndex="1" GridPane.rowIndex="4"/>

        <!-- Row 5: Email -->
        <Label text="Email:" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <TextField fx:id="emailField" promptText="Nhập email" prefHeight="35"
                   GridPane.columnIndex="1" GridPane.rowIndex="5"/>

        <columnConstraints>
            <ColumnConstraints minWidth="120" prefWidth="120"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="280"/>
        </columnConstraints>
    </GridPane>

    <HBox spacing="15" alignment="CENTER_RIGHT">
        <VBox.margin>
            <Insets top="10"/>
        </VBox.margin>
        <Button fx:id="btnCancel" text="Hủy" styleClass="secondary-button" prefWidth="100" prefHeight="35"/>
        <Button fx:id="btnSave" text="Lưu" styleClass="primary-button" prefWidth="100" prefHeight="35"/>
    </HBox>
</VBox>

