<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="vn.edu.iuh.fit.client.controller.RouteController"
            stylesheets="@../css/styles.css"
            prefWidth="1200" prefHeight="700">

    <center>
        <VBox spacing="18" styleClass="main-content">
            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="Quản Lý Tuyến Đường" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblResultCount" text="" styleClass="page-label"/>
            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <ComboBox fx:id="startStationCombo" promptText="Tất cả ga đi" prefWidth="180" styleClass="filter-combo"/>
                <ComboBox fx:id="endStationCombo" promptText="Tất cả ga đến" prefWidth="180" styleClass="filter-combo"/>
                <ComboBox fx:id="statusCombo" promptText="Tất cả trạng thái" prefWidth="170" styleClass="filter-combo"/>
                <Button fx:id="btnFilter" text="Lọc" onAction="#handleFilter" styleClass="primary-button"/>
                <Button fx:id="btnRefresh" text="Làm mới" onAction="#handleRefresh" styleClass="secondary-button"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnAddRoute" text="Thêm tuyến" onAction="#handleAddRoute" styleClass="add-button"/>
            </HBox>

            <TableView fx:id="routeTable" VBox.vgrow="ALWAYS" styleClass="data-table">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="codeColumn" text="Mã tuyến" minWidth="110"/>
                    <TableColumn fx:id="startStationColumn" text="Ga đi" minWidth="140"/>
                    <TableColumn fx:id="stopsColumn" text="Ga dừng" minWidth="190"/>
                    <TableColumn fx:id="endStationColumn" text="Ga đến" minWidth="140"/>
                    <TableColumn fx:id="segmentsColumn" text="Chặng suy luận" minWidth="260"/>
                    <TableColumn fx:id="priceColumn" text="Giá cơ bản" minWidth="110"/>
                    <TableColumn fx:id="statusColumn" text="Trạng thái" minWidth="120"/>
                </columns>
            </TableView>

            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button fx:id="btnDevelopRoute" text="Phát triển" onAction="#handleDevelopRoute" styleClass="secondary-button"/>
                <Button fx:id="btnDisableRoute" text="Tạm dừng" onAction="#handleDisableRoute" styleClass="secondary-button"/>
                <Button fx:id="btnEditRoute" text="Sửa" onAction="#handleEditRoute" styleClass="primary-button"/>
                <Button fx:id="btnDeleteRoute" text="Xóa" onAction="#handleDeleteRoute" styleClass="danger-button"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
