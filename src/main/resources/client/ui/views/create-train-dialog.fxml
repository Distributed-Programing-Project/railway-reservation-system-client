<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="vn.edu.iuh.fit.client.controller.CreateTrainDialogController"
      stylesheets="@../css/train-management.css"
      spacing="14" prefWidth="720" prefHeight="560"
      style="-fx-padding: 24;">

    <Label text="Lập tàu mới" styleClass="dialog-title"/>

    <Separator/>

    <!-- Train code -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Mác tàu:" styleClass="field-label" prefWidth="80"/>
        <TextField fx:id="txtTrainCode" styleClass="text-field" prefWidth="220"
                   promptText="Ví dụ: SE5, TN2 (max 10 ký tự)"/>
    </HBox>

    <Separator/>

    <!-- Carriage selection panels -->
    <HBox spacing="16" VBox.vgrow="ALWAYS" alignment="TOP_CENTER">

        <!-- LEFT: Pool of available carriages -->
        <VBox spacing="8" HBox.hgrow="ALWAYS" prefWidth="270" maxWidth="Infinity">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Pool toa rỗng" styleClass="panel-title"/>
            </HBox>

            <ComboBox fx:id="cmbPoolFilter"
                      styleClass="filter-combo"
                      maxWidth="Infinity"/>

            <ListView fx:id="poolList"
                      VBox.vgrow="ALWAYS"
                      prefHeight="300"
                      maxWidth="Infinity"/>
        </VBox>

        <!-- MIDDLE: Transfer buttons -->
        <VBox spacing="8" alignment="CENTER" prefWidth="120" minWidth="120" maxWidth="120">
            <Button text="Thêm →"
                    styleClass="primary-button"
                    prefWidth="110"
                    onAction="#handleAddCarriage"/>

            <Button text="← Bỏ"
                    styleClass="secondary-button"
                    prefWidth="110"
                    onAction="#handleRemoveCarriage"/>

            <Separator prefWidth="110"/>

            <Button text="↑ Lên"
                    styleClass="secondary-button"
                    prefWidth="110"
                    onAction="#handleMoveUp"/>

            <Button text="↓ Xuống"
                    styleClass="secondary-button"
                    prefWidth="110"
                    onAction="#handleMoveDown"/>
        </VBox>

        <!-- RIGHT: Selected carriages (ordered) -->
        <VBox spacing="8" HBox.hgrow="ALWAYS" prefWidth="270" maxWidth="Infinity">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Toa đã chọn (theo thứ tự)"
                       styleClass="panel-title"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="lblCarriageCount"
                       text="0 / 16 toa"
                       styleClass="count-badge count-badge-warn"/>
            </HBox>

            <ListView fx:id="selectedList"
                      VBox.vgrow="ALWAYS"
                      prefHeight="300"
                      maxWidth="Infinity"/>
        </VBox>

    </HBox>

    <!-- Actions -->
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="btnCancel" text="Hủy"
                styleClass="secondary-button" onAction="#handleCancel"/>
        <Button text="Xác nhận tạo tàu"
                styleClass="primary-button" onAction="#handleSave"/>
    </HBox>

</VBox>